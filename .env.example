# Copy this file to .env and fill in real values locally. Never commit .env.
# Names only: no secrets, keys, or production values belong in this file.

APP_ENV=local
WEB_ORIGIN=http://localhost:5173

# Local development values matching infra/docker-compose.yml. These are not
# secrets (the compose file already contains the same local passwords);
# staging replaces them from the platform secret store.
DATABASE_URL=postgresql://vistaro_app:vistaro_app_local_only@localhost:5432/vistaro
MIGRATOR_DATABASE_URL=postgresql://vistaro_migrator:vistaro_migrator_local_only@localhost:5432/vistaro
REDIS_URL=redis://localhost:6379/0

SESSION_SECRET=
ENCRYPTION_KEYS=

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
RESEND_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

SENTRY_DSN=
