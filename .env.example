# Copy this file to .env and fill in real values locally. Never commit .env.
# Names only: no secrets, keys, or production values belong in this file.

APP_ENV=local
WEB_ORIGIN=http://localhost:5173

# Local development values matching infra/docker-compose.yml. These are not
# secrets (the compose file already contains the same local passwords);
# staging replaces them from the platform secret store.
DATABASE_URL=postgresql://vistaro_app:vistaro_app_local_only@localhost:5432/vistaro
MIGRATOR_DATABASE_URL=postgresql://vistaro_migrator:vistaro_migrator_local_only@localhost:5432/vistaro
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

SESSION_SECRET=
ENCRYPTION_KEYS=

# AUTH-001 email/session defaults (safe local values).
SESSION_LIFETIME_SECONDS=604800
VERIFICATION_TOKEN_TTL_SECONDS=86400
EMAIL_FROM=Vistaro <no-reply@vistaro.local>
SMTP_HOST=localhost
SMTP_PORT=1025
API_BASE_URL=http://127.0.0.1:8000

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
RESEND_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

SENTRY_DSN=
