{
  "components": {
    "schemas": {
      "AddMemberRequest": {
        "additionalProperties": false,
        "description": "Payload: the account email plus the role to grant.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "default": "editor",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "AddMemberRequest",
        "type": "object"
      },
      "AuthResponse": {
        "additionalProperties": false,
        "description": "Body of signup/login: the user plus the session-bound CSRF token.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "csrf_token"
        ],
        "title": "AuthResponse",
        "type": "object"
      },
      "DependencyChecks": {
        "description": "Breakdown of readiness dependency statuses.",
        "properties": {
          "database": {
            "description": "PostgreSQL connectivity status ('ok' or 'failed')",
            "title": "Database",
            "type": "string"
          },
          "redis": {
            "description": "Redis connectivity status ('ok' or 'failed')",
            "title": "Redis",
            "type": "string"
          }
        },
        "required": [
          "database",
          "redis"
        ],
        "title": "DependencyChecks",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "description": "Inner error payload containing code, message, and optional details.",
        "properties": {
          "code": {
            "description": "Machine-readable error code",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "description": "Optional structured error details",
            "title": "Details"
          },
          "message": {
            "description": "Human-readable error description",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "description": "Standard Vistaro API error envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness check response.",
        "properties": {
          "environment": {
            "description": "Deployment environment name",
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "default": "ok",
            "description": "Process liveness status",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "environment"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MemberList": {
        "additionalProperties": false,
        "description": "All members of the workspace.",
        "properties": {
          "members": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceMember"
            },
            "title": "Members",
            "type": "array"
          }
        },
        "required": [
          "members"
        ],
        "title": "MemberList",
        "type": "object"
      },
      "ReadyResponse": {
        "description": "Readiness check response.",
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/DependencyChecks",
            "description": "Individual dependency check results"
          },
          "environment": {
            "description": "Deployment environment name",
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "description": "Readiness status ('ok' or 'unhealthy')",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "environment",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SignupRequest": {
        "additionalProperties": false,
        "description": "Signup payload: an email and a password of at least 10 characters.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 10,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignupRequest",
        "type": "object"
      },
      "UserOut": {
        "additionalProperties": false,
        "description": "Public account fields. Never includes ``password_hash``.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "email_verified"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyResponse": {
        "additionalProperties": false,
        "description": "Body of a successful verification link visit.",
        "properties": {
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          }
        },
        "required": [
          "email_verified"
        ],
        "title": "VerifyResponse",
        "type": "object"
      },
      "WorkspaceCreate": {
        "additionalProperties": false,
        "description": "Payload: the new workspace's display name.",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "WorkspaceCreate",
        "type": "object"
      },
      "WorkspaceList": {
        "additionalProperties": false,
        "description": "All workspaces the caller belongs to.",
        "properties": {
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceOut"
            },
            "title": "Workspaces",
            "type": "array"
          }
        },
        "required": [
          "workspaces"
        ],
        "title": "WorkspaceList",
        "type": "object"
      },
      "WorkspaceMember": {
        "additionalProperties": false,
        "description": "One member of a workspace (emails are shared with co-members).",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "role"
        ],
        "title": "WorkspaceMember",
        "type": "object"
      },
      "WorkspaceOut": {
        "additionalProperties": false,
        "description": "A workspace plus the caller's role in it.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "created_at"
        ],
        "title": "WorkspaceOut",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Vistaro AI Platform API",
    "title": "Vistaro API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/google/callback": {
      "get": {
        "description": "Exchange the code, resolve the user, mint a session like login does.\n\nAll failures (bad/outdated state, provider errors, missing/unverified\nemail claims) share one generic envelope so nothing about the account\nleaks. The redirect to the web app lands with UI-001; for now the JSON\nbody + cookies are the end of the flow.",
        "operationId": "google_callback_auth_google_callback_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Generic sign-in failure envelope"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Finish Google sign-in",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/google/login": {
      "get": {
        "description": "Redirect the browser to Google's consent screen (or answer 503).\n\nAuthlib stores the anti-forgery ``state`` in the signed Starlette session\n(``SessionMiddleware`` with ``settings.session_secret``) and re-checks it\nduring the token exchange, so this route needs no extra cookies.",
        "operationId": "google_login_auth_google_login_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          },
          "503": {
            "description": "Google credentials missing (feature off)"
          }
        },
        "summary": "Start Google sign-in",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Verify Argon2id credentials and mint a fresh session with bound CSRF.\n\nUnknown accounts burn the same Argon2id work as a wrong password so\ntiming cannot enumerate emails.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Wrong email or password (same envelope for both)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Sign in with an email and password",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Remove the session row and clear both cookies.\n\nRequires the session-bound CSRF token (enforced by ``CurrentUser`` on\nthis unsafe method).",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Logout Auth Logout Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid session"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Delete the current session",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Return the caller's own account summary (no secrets).",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Current account summary",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/signup": {
      "post": {
        "description": "Create the ``users`` row unverified, issue a session, email the link.\n\nBy design signup reveals registration truthfully: the duplicate case\nanswers 409 explicitly (the anti-enumeration rule is applied on login).",
        "operationId": "signup_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Email already registered"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Create an account and start a session",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/verify": {
      "get": {
        "description": "Consume one verification token and mark the account verified.\n\nAll failure modes (garbage token, expired, reused) return one identical\nenvelope, so nothing about account state leaks through timing or text.\nEmail-link rotation of any live session arrives with the browser flows\n(Phase B); server-side verification is idempotent-safe via ``consumed_at``.",
        "operationId": "verify_auth_verify_get",
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid, expired, or already-used link"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Confirm an email address with a one-time link",
        "tags": [
          "Auth"
        ]
      }
    },
    "/csrf": {
      "get": {
        "description": "Issue a short-lived CSRF token, re-bound to a live session if present.",
        "operationId": "csrf_token_csrf_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Csrf Token Csrf Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Get a CSRF token",
        "tags": [
          "System"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Indicates whether the API process is alive.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Process is running"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "System"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Indicates whether the API and dependencies (Postgres, Redis) can serve traffic.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "All dependencies are healthy and ready"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "One or more dependencies are unhealthy"
          }
        },
        "summary": "Readiness check",
        "tags": [
          "System"
        ]
      }
    },
    "/workspaces": {
      "get": {
        "description": "List every workspace the caller has a membership row for.\n\nRuns with only the user GUC: RLS's user branch scopes the read, so the\ncaller sees exactly their own memberships even though the query has no\nexplicit workspace filter.",
        "operationId": "list_workspaces_workspaces_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "List the workspaces I belong to",
        "tags": [
          "Workspaces"
        ]
      },
      "post": {
        "description": "Create the workspace and one owner membership in one transaction.\n\nThe membership INSERT is gated by RLS ``WITH CHECK``: the transaction's\nworkspace GUC is therefore set to the NEW id before the insert, proving\nthe same policy future member-grants rely on.",
        "operationId": "create_workspace_workspaces_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Create a workspace (creator becomes owner)",
        "tags": [
          "Workspaces"
        ]
      }
    },
    "/workspaces/{workspace_id}/members": {
      "get": {
        "description": "List members of a workspace the caller belongs to.\n\nOther members' emails are shared with co-members by design (collaboration\nsurface); flagged for the founders in the review notes.",
        "operationId": "list_members_workspaces__workspace_id__members_get",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "title": "Workspace Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberList"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not a member (generic, no existence leak)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "List the workspace's members",
        "tags": [
          "Workspaces"
        ]
      },
      "post": {
        "description": "Grant a role to an existing account within the caller's workspace.\n\nAuthorization (MVP rule): the actor needs the ``owner`` or ``admin``\nrole. The INSERT runs with the workspace GUC set, so RLS WITH CHECK\nwould reject a cross-workspace grant even if authorization regressed.\nReturns the full member list so the client stays consistent.",
        "operationId": "add_member_workspaces__workspace_id__members_post",
        "parameters": [
          {
            "in": "path",
            "name": "workspace_id",
            "required": true,
            "schema": {
              "title": "Workspace Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberList"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Already a member"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
